<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FulcrumFS</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Required by the LibraryImport source generator (directory flushes on Unix). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PackageId>Singulink.FulcrumFS.Local</PackageId>
    <Description>Local file system implementation of the FulcrumFS repository.</Description>
    <PackageTags></PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />

    <PackageReference Include="Singulink.Enums" />
    <PackageReference Include="Singulink.IO.FileSystem" />
    <PackageReference Include="Singulink.Threading" />

    <PackageReference Include="Nito.AsyncEx.Coordination" />

    <!-- Analyzers -->
    <PackageReference Include="hamarb123.Analyzers" PrivateAssets="All" />
    <PackageReference Include="Roslyn.Diagnostics.Analyzers" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FulcrumFS\FulcrumFS.csproj" />
  </ItemGroup>
</Project>
