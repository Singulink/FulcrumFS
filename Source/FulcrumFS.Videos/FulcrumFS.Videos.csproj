<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <PackageId>Singulink.FulcrumFS.Videos</PackageId>
    <Description>
      FulcrumFS extension that adds customizable video processing capabilities, including validation, thumbnail generation, resizing, format conversion,
      metadata stripping, bitrate limiting, and audio stripping, for both original videos and their derived variants.
    </Description>
    <PackageTags></PackageTags>

    <!-- Handling for special custom hwaccel config mode -->
    <DefineConstants Condition=" '$(HWACCEL_MODE)' != '' ">$(DefineConstants);CUSTOM_HWACCEL_MODE</DefineConstants>
    <DefineConstants Condition=" '$(HWACCEL_MODE)' == 'none' ">$(DefineConstants);CUSTOM_HWACCEL_MODE_NONE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FulcrumFS\FulcrumFS.csproj" />

    <!-- Analyzers -->
    <PackageReference Include="hamarb123.Analyzers" PrivateAssets="All" />
  </ItemGroup>

</Project>
